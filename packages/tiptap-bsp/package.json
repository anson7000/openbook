{
  "name": "@openbook/tiptap-bsp",
  "version": "1.0.0",
  "description": "BSP extension for tiptap",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "@openbook/typescript-config": "workspace:*",
    "@tiptap/core": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "tsdown": "^0.23.7"
  }
}
