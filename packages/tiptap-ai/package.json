{
  "name": "@openbook/tiptap-ai",
  "version": "1.0.0",
  "description": "An AI extension for tiptap",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "@openbook/typescript-config": "workspace:*"
  }
}
